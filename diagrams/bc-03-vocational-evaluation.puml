@startuml
skinparam packageStyle rectangle
skinparam shadowing false
top to bottom direction

package "Vocational Evaluation Context" {

    package "Domain Layer" #FEFECE {
        enum TestStatus {
            STARTED
            PAUSED
            COMPLETED
            ABANDONED
        }
        class VocationalTest {
            - id: String
            - studentId: String
            - startedAt: DateTime
            - completedAt: DateTime
            - status: TestStatus
            + startTest(): Void
            + pauseTest(): Void
            + completeTest(): Void
            + updateAnswer(questionId: String, answer: String): Void
        }
        class VocationalProfile {
            - id: String
            - studentId: String
            - primaryTraits: List<String>
            - feedbackSummary: String
            - calculatedAt: DateTime
        }
        interface IVocationalTestRepository <<interface>> {
            + findById(id: String): VocationalTest
            + save(test: VocationalTest): Boolean
        }

        VocationalTest "1" *-- "1" VocationalProfile
    }

    package "Application Layer" #E2EFFF {
        class EvaluationApplicationService <<Application Service>> {
            - testRepository: IVocationalTestRepository
            - aiVocationalService: AIVocationalService
            + startTest(studentId: String): VocationalTest
            + submitTest(testId: String): VocationalProfile
        }
        EvaluationApplicationService ..> IVocationalTestRepository
    }

    package "Infrastructure Layer" #E5F9E7 {
        class VocationalTestRepositoryImpl {
            - dbContext: Object
            + findById(id: String): VocationalTest
            + save(test: VocationalTest): Boolean
        }
        class AIVocationalService <<External API>> {
            + generateFeedback(testId: String): String
            + calculateVocationalProfile(testId: String): VocationalProfile
        }
        VocationalTestRepositoryImpl ..|> IVocationalTestRepository
        EvaluationApplicationService ..> AIVocationalService
    }
}
@enduml

@startuml "VocaFy Master ERD"

hide circle
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

package "User Registration & Profile Context" {
    entity "users" as users {
        * id : VARCHAR(36) <<PK>>
        --
        * email : VARCHAR(255) <<UNIQUE>>
        * password_hash : VARCHAR(255)
        * role : VARCHAR(20)
        * is_session_active : BOOLEAN
        * created_at : TIMESTAMP
    }

    entity "students" as students {
        * id : VARCHAR(36) <<PK, FK>>
        --
        school_or_university : VARCHAR(255)
        current_cycle : VARCHAR(50)
        linked_psychologist_code : VARCHAR(50)
    }

    entity "psychologists" as psychologists {
        * id : VARCHAR(36) <<PK, FK>>
        --
        professional_license : VARCHAR(100)
        specialty : VARCHAR(100)
        unique_linking_code : VARCHAR(50) <<UNIQUE>>
    }

    entity "password_reset_tokens" as password_reset_tokens {
        * id : VARCHAR(36) <<PK>>
        --
        * user_id : VARCHAR(36) <<FK>>
        * token : VARCHAR(255)
        * expiration_date : TIMESTAMP
        * is_used : BOOLEAN
    }

    entity "psychologist_links" as psychologist_links {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * psychologist_code : VARCHAR(50)
        * is_linked : BOOLEAN
        created_at : TIMESTAMP
    }
}

package "Vocational Evaluation & Career Exploration Context" {
    entity "vocational_tests" as vocational_tests {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * status : VARCHAR(20)
        * started_at : TIMESTAMP
        completed_at : TIMESTAMP
    }

    entity "vocational_profiles" as vocational_profiles {
        * id : VARCHAR(36) <<PK>>
        --
        * test_id : VARCHAR(36) <<FK, UNIQUE>>
        * student_id : VARCHAR(36) <<FK>>
        primary_traits : JSONB
        feedback_summary : TEXT
        calculated_at : TIMESTAMP
    }

    entity "careers" as careers {
        * id : VARCHAR(36) <<PK>>
        --
        * title : VARCHAR(150)
        description : TEXT
        field_of_study : VARCHAR(100)
        average_salary : DECIMAL(10,2)
    }

    entity "career_searches" as career_searches {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * search_query : VARCHAR(255)
        applied_filters : JSONB
        searched_at : TIMESTAMP
    }

    entity "career_compatibilities" as career_compatibilities {
        * id : VARCHAR(36) <<PK>>
        --
        * career_id : VARCHAR(36) <<FK>>
        * student_profile_id : VARCHAR(36) <<FK>>
        * compatibility_percentage : DECIMAL(5,2)
    }

    entity "vocational_plans" as vocational_plans {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        roadmap_steps : JSONB
        is_adjusted : BOOLEAN
        generated_at : TIMESTAMP
    }
}

package "Student Monitoring & Reports Context" {
    entity "professional_observations" as professional_observations {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * psychologist_id : VARCHAR(36) <<FK>>
        * observation_text : TEXT
        * created_at : TIMESTAMP
    }

    entity "vocational_reports" as vocational_reports {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * report_type : VARCHAR(50)
        content_summary : TEXT
        is_validated_by_psychologist : BOOLEAN
        created_at : TIMESTAMP
    }

    entity "group_comparison_reports" as group_comparison_reports {
        * id : VARCHAR(36) <<PK>>
        --
        * psychologist_id : VARCHAR(36) <<FK>>
        selected_group_ids : JSONB
        aggregated_conclusions : TEXT
        created_at : TIMESTAMP
    }
}

package "Payment & Subscription Context" {
    entity "subscriptions" as subscriptions {
        * id : VARCHAR(36) <<PK>>
        --
        * student_id : VARCHAR(36) <<FK>>
        * plan_type : VARCHAR(50)
        * is_active : BOOLEAN
        * expiration_date : TIMESTAMP
    }

    entity "payment_transactions" as payment_transactions {
        * transaction_id : VARCHAR(36) <<PK>>
        --
        * subscription_id : VARCHAR(36) <<FK>>
        * amount : DECIMAL(10,2)
        * payment_status : VARCHAR(20)
        * processed_at : TIMESTAMP
    }
}

package "Scheduling & Session Context" {
    entity "sessions" as sessions {
        * id : VARCHAR(36) <<PK>>
        --
        * psychologist_id : VARCHAR(36) <<FK>>
        * session_type : VARCHAR(20)
        * scheduled_date_time : TIMESTAMP
        * duration_minutes : INT
        * status : VARCHAR(20)
        notes : TEXT
    }

    entity "individual_sessions" as individual_sessions {
        * session_id : VARCHAR(36) <<PK, FK>>
        --
        * student_id : VARCHAR(36) <<FK>>
    }

    entity "group_sessions" as group_sessions {
        * session_id : VARCHAR(36) <<PK, FK>>
        --
        max_participants : INT
        grouping_criteria : VARCHAR(100)
    }
}

package "Community & Chat Context" {
    entity "communities" as communities {
        * id : VARCHAR(36) <<PK>>
        --
        * title : VARCHAR(100)
        description : TEXT
        category : VARCHAR(50)
    }

    entity "community_posts" as community_posts {
        * id : VARCHAR(36) <<PK>>
        --
        * community_id : VARCHAR(36) <<FK>>
        * author_id : VARCHAR(36) <<FK>>
        * content : TEXT
        is_reported : BOOLEAN
        created_at : TIMESTAMP
    }

    entity "community_comments" as community_comments {
        * id : VARCHAR(36) <<PK>>
        --
        * post_id : VARCHAR(36) <<FK>>
        * author_id : VARCHAR(36) <<FK>>
        * content : TEXT
        created_at : TIMESTAMP
    }

    entity "chat_messages" as chat_messages {
        * id : VARCHAR(36) <<PK>>
        --
        * sender_id : VARCHAR(36) <<FK>>
        * receiver_id : VARCHAR(36) <<FK>>
        * content : TEXT
        is_read : BOOLEAN
        sent_at : TIMESTAMP
    }
}

package "System Notifications Context" {
    entity "notifications" as notifications {
        * id : VARCHAR(36) <<PK>>
        --
        * recipient_user_id : VARCHAR(36) <<FK>>
        * title : VARCHAR(100)
        * message : TEXT
        * type : VARCHAR(30)
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
}

' ==========================================
' RELACIONES E INTEGRIDAD REFERENCIAL
' ==========================================

' User Registration
users ||--o| students
users ||--o| psychologists
users ||--o{ password_reset_tokens
students ||--o{ psychologist_links

' Vocational Evaluation & Career Exploration
students ||--o{ vocational_tests
students ||--o{ career_searches
vocational_tests ||--|| vocational_profiles
vocational_profiles ||--o{ career_compatibilities
careers ||--o{ career_compatibilities
students ||--o| vocational_plans

' Student Monitoring & Reports
students ||--o{ professional_observations
psychologists ||--o{ professional_observations
students ||--o{ vocational_reports
psychologists ||--o{ group_comparison_reports

' Payment & Subscriptions
students ||--o{ subscriptions
subscriptions ||--o{ payment_transactions

' Scheduling & Sessions
psychologists ||--o{ sessions
sessions ||--o| individual_sessions
sessions ||--o| group_sessions
students ||--o{ individual_sessions

' Community & Chat
communities ||--o{ community_posts
users ||--o{ community_posts
community_posts ||--o{ community_comments
users ||--o{ community_comments
users ||--o{ chat_messages : "sender"
users ||--o{ chat_messages : "receiver"

' Notifications
users ||--o{ notifications

@enduml
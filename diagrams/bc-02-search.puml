@startuml
skinparam packageStyle rectangle
skinparam shadowing false
top to bottom direction

package "Search Context" {

    package "Domain Layer" #FEFECE {
        class CareerSearch {
            - searchQuery: String
            - filtersApplied: Map<String, String>
            - searchHistory: List<String>
            + searchByNavigationBar(query: String): List<Object>
            + searchByFilters(filters: Map): List<Object>
            + saveSearch(): Void
        }
        interface ICareerSearchRepository <<interface>> {
            + saveSearchHistory(studentId: String, query: String): Void
            + getSearchHistory(studentId: String): List<String>
        }
    }

    package "Application Layer" #E2EFFF {
        class SearchApplicationService <<Application Service>> {
            - searchRepository: ICareerSearchRepository
            + executeSearch(query: String, filters: Map): List<Object>
        }
        SearchApplicationService ..> ICareerSearchRepository
    }

    package "Infrastructure Layer" #E5F9E7 {
        class CareerSearchRepositoryImpl {
            - dbContext: Object
            + saveSearchHistory(studentId: String, query: String): Void
            + getSearchHistory(studentId: String): List<String>
        }
        CareerSearchRepositoryImpl ..|> ICareerSearchRepository
    }
}
@enduml

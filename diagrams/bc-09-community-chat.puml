@startuml
skinparam packageStyle rectangle
skinparam shadowing false
top to bottom direction

package "Community & Chat Context" {

    package "Domain Layer" #FEFECE {
        class Community {
            - id: String
            - title: String
            - description: String
            - category: String
            + join(studentId: String): Boolean
            + publishPost(post: CommunityPost): Void
        }
        class CommunityPost {
            - id: String
            - communityId: String
            - authorId: String
            - content: String
            - createdAt: DateTime
            - isReported: Boolean
            + addComment(comment: CommunityComment): Void
            + react(userId: String, reactionType: String): Void
            + report(reason: String): Void
        }
        class CommunityComment {
            - id: String
            - postId: String
            - authorId: String
            - content: String
            - createdAt: DateTime
        }
        class ChatMessage {
            - id: String
            - senderId: String
            - receiverId: String
            - content: String
            - sentAt: DateTime
            - isRead: Boolean
            + sendMessage(): Boolean
            + markAsRead(): Void
        }
        interface ICommunityRepository <<interface>> {
            + findById(id: String): Community
            + savePost(post: CommunityPost): Boolean
        }
        interface IChatRepository <<interface>> {
            + saveMessage(message: ChatMessage): Boolean
        }

        Community "1" *-- "0..*" CommunityPost
        CommunityPost "1" *-- "0..*" CommunityComment
    }

    package "Application Layer" #E2EFFF {
        class CommunityApplicationService <<Application Service>> {
            - communityRepository: ICommunityRepository
            + publishPost(command: Object): Void
        }
        class ChatApplicationService <<Application Service>> {
            - chatRepository: IChatRepository
            + sendMessage(command: Object): Boolean
        }
        CommunityApplicationService ..> ICommunityRepository
        ChatApplicationService ..> IChatRepository
    }

    package "Infrastructure Layer" #E5F9E7 {
        class CommunityRepositoryImpl {
            - dbContext: Object
            + findById(id: String): Community
            + savePost(post: CommunityPost): Boolean
        }
        class ChatRepositoryImpl {
            - dbContext: Object
            + saveMessage(message: ChatMessage): Boolean
        }
        CommunityRepositoryImpl ..|> ICommunityRepository
        ChatRepositoryImpl ..|> IChatRepository
    }
}
@enduml

@startuml
skinparam packageStyle rectangle
skinparam shadowing false
top to bottom direction

package "Career Exploration & Planning Context" {

    package "Domain Layer" #FEFECE {
        class Career {
            - id: String
            - title: String
            - description: String
            - fieldOfStudy: String
            - averageSalary: Double
        }
        class CareerCompatibility {
            - careerId: String
            - studentProfileId: String
            - compatibilityPercentage: Double
            + calculateCompatibility(): Double
        }
        class VocationalPlan {
            - id: String
            - studentId: String
            - roadmapSteps: List<String>
            - generatedAt: DateTime
            - isAdjusted: Boolean
            + adjustPlan(newPreferences: Object): Void
        }
        interface ICareerRepository <<interface>> {
            + search(query: String): List<Career>
            + findById(id: String): Career
        }
        interface IVocationalPlanRepository <<interface>> {
            + findByStudentId(studentId: String): VocationalPlan
            + save(plan: VocationalPlan): Boolean
        }

        Career "1" -- "0..*" CareerCompatibility
        VocationalPlan "1" -- "0..*" CareerCompatibility
    }

    package "Application Layer" #E2EFFF {
        class CareerPlanningApplicationService <<Application Service>> {
            - careerRepository: ICareerRepository
            - planRepository: IVocationalPlanRepository
            - aiCareerService: AICareerService
            + exploreCareers(query: String): List<Career>
            + generatePlan(profileId: String): VocationalPlan
        }
        CareerPlanningApplicationService ..> ICareerRepository
        CareerPlanningApplicationService ..> IVocationalPlanRepository
    }

    package "Infrastructure Layer" #E5F9E7 {
        class CareerRepositoryImpl {
            - dbContext: Object
            + search(query: String): List<Career>
            + findById(id: String): Career
        }
        class AICareerService <<External API>> {
            + compareCareers(careerIds: List<String>): Object
            + simulateCareerTrajectory(profileId: String, careerId: String): String
            + generateVocationalPlan(profileId: String): VocationalPlan
        }
        CareerRepositoryImpl ..|> ICareerRepository
        CareerPlanningApplicationService ..> AICareerService
    }
}
@enduml
